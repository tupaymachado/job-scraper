# Copiar para worker/.env e preencher. NUNCA commitar o .env.
#   cp .env.example .env && chmod 600 .env

# Supabase — a service_role key passa por cima da RLS. Só na VM, nunca na Vercel.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# openCode Zen — https://opencode.ai/auth
# O tier Go tem base URL própria: https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Careerjet — opcional. Chave da API v4 (Basic auth, usuário = chave).
# Registro grátis: https://www.careerjet.com/partners/api/
CAREERJET_AFFID=

# Modelos (opcional). Confira o que a SUA chave alcança antes de mudar:
#   curl -H "Authorization: Bearer $OPENCODE_API_KEY" $OPENCODE_BASE_URL/models
# O catálogo varia por tier — o Go, por exemplo, não tem Gemini nem Claude.
# Cuidado com dois detalhes ao trocar de modelo:
#   - modelos de reasoning gastam max_tokens pensando antes de responder;
#     estourar o limite devolve content VAZIO, não erro (ver ai/client.py)
#   - alguns rejeitam temperature=0, que é o que o worker manda
ENRICH_MODEL=glm-5.2
MATCH_MODEL=glm-5.2
