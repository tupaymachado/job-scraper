[Unit]
Description=Job Scraper — coleta das fontes HTTP (LinkedIn, Gupy, Programathor, Ampla, Vagas.com, Careerjet)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/job-scraper/worker
ExecStart=%h/projects/job-scraper/.venv/bin/python run.py --source all --once
# Coleta é I/O-bound; não deve competir com o resto da VM.
Nice=10
TimeoutStartSec=1800
