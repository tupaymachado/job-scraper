[Unit]
Description=Job Scraper — fontes com browser: Selecty (Harmona, InCompany) + Google Jobs (best-effort)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/job-scraper/worker
ExecStart=%h/projects/job-scraper/.venv/bin/python run.py --source browser --once
Nice=10
TimeoutStartSec=1800
