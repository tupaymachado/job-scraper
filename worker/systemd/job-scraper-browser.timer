[Unit]
Description=Job Scraper — fontes com browser 1x/dia

[Timer]
# 1x/dia: o Google flagra o IP após um acesso automatizado e a Selecty dá
# 403 para IP de datacenter. Rodar mais vezes só gera 'blocked' — não
# aumentar a frequência.
OnCalendar=*-*-* 07:30:00
RandomizedDelaySec=3600
Persistent=true

[Install]
WantedBy=timers.target
